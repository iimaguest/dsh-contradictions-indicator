{
  "name": "dsh-contradictions-indicator",
  "version": "2.0.1",
  "description": "Parallel contradiction analysis for DSH conversations: a 0-100 coherence score badge with commentary, manual trigger, and auto-analysis on by default (interval editable, off per conversation or globally). Reuses the conversation's exact prefix so the provider KV cache stays warm.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "Apache-2.0",
  "author": "iimaguest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iimaguest/dsh-contradictions-indicator.git"
  },
  "bugs": {
    "url": "https://github.com/iimaguest/dsh-contradictions-indicator/issues"
  },
  "homepage": "https://github.com/iimaguest/dsh-contradictions-indicator#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "contradictions",
    "coherence"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
